{
  "name": "reuse-os-cloudflare-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute DB --local --file=./schema.sql",
